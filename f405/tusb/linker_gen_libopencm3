arm-none-eabi-gcc -E \
    -mcpu=cortex-m4 \
    -mthumb \
    -mfloat-abi=hard \
    -mfpu=fpv4-sp-d16 \
    -DSTM32F4 \
    -DSTM32F405xx \
    -D_ROM=1024K \
    -D_RAM=128K \
    -D_CCM=64K \
    -D_CCM_OFF=0x10000000 \
    -D_ROM_OFF=0x08000000 \
    -D_RAM_OFF=0x20000000 \
    -P -E \
    ./locm3_lnk/ld/linker.ld.S \
    -o generated.stm32f405xx.ld

